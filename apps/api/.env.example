NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/residencial
DATABASE_SSL=false
# En producción vienen de AWS Secrets Manager (mínimo 32 caracteres)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:5173
RUN_MIGRATIONS=false
