# Plantilla de deploy/.env. Créalo con `sh generar-env.sh` (genera los secretos). NUNCA subas deploy/.env al repositorio.

# Dirección del sitio: ":80" sin dominio (solo HTTP por IP) o "app.midominio.com" para HTTPS automático
SITE_ADDRESS=:80

# Superusuario de la plataforma (se crea en el primer arranque; después se cambia la contraseña en Mi cuenta)
SUPERADMIN_USERNAME=ricardo
SUPERADMIN_PASSWORD=

# Horario de servicio (vacío = 24 h). Fuera de él la web muestra "Fuera de horario"
SERVICE_HOURS=09:00-18:00
TZ=America/El_Salvador

# Secretos (generar-env.sh los crea al azar)
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Días que se guardan los respaldos diarios en deploy/backups
BACKUP_KEEP_DAYS=14
